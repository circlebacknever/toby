diff --git a/billing/views.py b/billing/views.py
index d122d4f..1086208 100644
--- a/billing/views.py
+++ b/billing/views.py
@@ -1,9 +1,21 @@
 from django.http import HttpResponse
 from django.shortcuts import get_object_or_404, render
 
 from billing.models import Order
+from billing.receipts import render_receipt
 
 
 def invoice_view(request, order_id):
     order = get_object_or_404(Order, id=order_id, account=request.account)
     return render(request, "invoice.html", {"order": order})
+
+
+def receipt_view(request, order_id):
+    order = get_object_or_404(Order, id=order_id, account=request.account)
+    text = render_receipt(
+        order,
+        currency=order.currency,
+        locale=request.account.locale,
+        footer=request.account.receipt_footer,
+    )
+    return HttpResponse(text, content_type="text/plain; charset=utf-8")

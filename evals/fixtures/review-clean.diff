diff --git a/billing/receipts.py b/billing/receipts.py
index c2a7da2..9e54eb9 100644
--- a/billing/receipts.py
+++ b/billing/receipts.py
@@ -1,15 +1,42 @@
 from typing import assert_never
 
 from billing.models import OrderStatus
+from billing.money import format_amount
 
 
 def status_label(status: OrderStatus) -> str:
     match status:
         case "paid":
             return "Paid"
         case "pending":
             return "Awaiting payment"
         case "refunded":
             return "Refunded"
         case _:
             assert_never(status)
+
+
+def render_receipt(order, *, currency, locale, footer):
+    """Return the plain-text receipt for an order in any status.
+
+    The second line names the status, so a pending order's receipt says it is
+    awaiting payment. Amounts use the order's currency and the account's locale.
+    The tax line shows order.tax_cents, the tax charged. An empty footer adds no
+    line. The total line always shows order.total_cents, the amount charged.
+    """
+    lines = [f"Receipt for order {order.id}", status_label(order.status), ""]
+
+    for item in order.items.all():
+        amount = item.unit_cents * item.quantity
+        lines.append(f"{item.name} x{item.quantity}  {format_amount(amount, currency, locale)}")
+
+    for discount in order.discounts.all():
+        lines.append(f"Discount {discount.code}  -{format_amount(discount.cents_off, currency, locale)}")
+
+    lines.append(f"Tax  {format_amount(order.tax_cents, currency, locale)}")
+
+    lines.append("")
+    lines.append(f"Total  {format_amount(order.total_cents, currency, locale)}")
+    if footer:
+        lines.append(footer)
+    return "\n".join(lines)

diff --git a/tests/test_receipts.py b/tests/test_receipts.py
new file mode 100644
index 0000000..973a087
--- /dev/null
+++ b/tests/test_receipts.py
@@ -0,0 +1,23 @@
+from billing.receipts import render_receipt
+
+
+def test_receipt_total_is_the_amount_charged(paid_order):
+    text = render_receipt(paid_order, currency="USD", locale="en_US", footer="")
+    assert text.splitlines()[-1] == "Total  $41.80"
+
+
+def test_receipt_ends_with_the_account_footer(paid_order):
+    text = render_receipt(paid_order, currency="USD", locale="en_US", footer="Thanks!")
+    assert text.splitlines()[-1] == "Thanks!"
+
+
+def test_receipt_page_returns_the_receipt_as_text(account_client, paid_order):
+    response = account_client.get(f"/orders/{paid_order.id}/receipt")
+    assert response.status_code == 200
+    assert response["Content-Type"] == "text/plain; charset=utf-8"
+    assert response.content.decode().startswith(f"Receipt for order {paid_order.id}")
+
+
+def test_receipt_page_of_another_account_is_404(other_account_client, paid_order):
+    response = other_account_client.get(f"/orders/{paid_order.id}/receipt")
+    assert response.status_code == 404

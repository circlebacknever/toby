+import os
+from datetime import timedelta
+
+from django.utils import timezone
+
+from app.reports.models import Report
+from app.storage.s3 import S3Client
+
+ARCHIVE_AFTER_DAYS = 90
+
+
+class ReportArchiver:
+    def archive(self, report):
+        client = S3Client(bucket=os.environ["ARCHIVE_BUCKET"])
+        key = f"reports/{report.account_id}/{report.id}.csv"
+        client.put(key, report.to_csv())
+        report.archived_at = timezone.now()
+        report.save()
+
+
+def archive_old_reports():
+    """Archive every report older than ARCHIVE_AFTER_DAYS. Runs nightly from cron."""
+    cutoff = timezone.now() - timedelta(days=ARCHIVE_AFTER_DAYS)
+    reports = Report.objects.filter(created__gt=cutoff, archived_at__isnull=True)
+    archiver = ReportArchiver()
+    for report in reports:
+        archiver.archive(report)
+    return len(reports)
+
+

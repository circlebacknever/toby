diff --git a/tests/test_archive.py b/tests/test_archive.py
new file mode 100644
index 0000000..9a0b1c2
--- /dev/null
+++ b/tests/test_archive.py
@@ -0,0 +1,12 @@
+from unittest import mock
+
+from app.reports.archive import ReportArchiver
+
+
+def test_archive_sets_archived_at(report):
+    with mock.patch("app.reports.archive.S3Client") as client:
+        ReportArchiver().archive(report)
+    client.return_value.put.assert_called_once()
+    report.refresh_from_db()
+    assert report.archived_at is not None
